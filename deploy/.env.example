# Hosted deployment settings. Copy to .env in this folder and fill in:
#
#   cp deploy/.env.example deploy/.env
#
# The file holds no application keys. Those belong in the repository's own
# .env (see ".env.example" in the repository root) because the app reads them
# there; this file only tells compose and Caddy what to serve and how.

# The name people type. It must already have an A (or AAAA) record pointing at
# this server before the first start, or Caddy cannot obtain a certificate.
# No scheme, no trailing slash: fires.example.org
DOMAIN=

# Address for certificate expiry notices. Let's Encrypt uses it; it is not
# published anywhere.
ACME_EMAIL=

# Optional. Change only to point Caddy somewhere other than the app container.
# APP_UPSTREAM=app:4173
